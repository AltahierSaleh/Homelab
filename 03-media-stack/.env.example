# Copy this file to `.env` and fill in YOUR values.
# `.env` should be git-ignored — never commit real VPN keys.

# ── User / permissions ───────────────────────────────────────────────
# Run `id <youruser>` on the VM to get these. Keeps file ownership sane.
PUID=1000
PGID=1000
TZ=Europe/London

# ── Where container configs live on the VM (NOT on the NAS) ───────────
CONFIG_ROOT=/opt/appdata

# ── VPN (gluetun) ────────────────────────────────────────────────────
# Provider name as gluetun expects it, e.g. mullvad, protonvpn, nordvpn, pia…
# Full list + required vars: https://github.com/qdm12/gluetun-wiki
VPN_PROVIDER=CHANGE_ME
VPN_COUNTRIES=Netherlands

# WireGuard creds from your VPN provider's config file:
WIREGUARD_PRIVATE_KEY=CHANGE_ME
WIREGUARD_ADDRESSES=10.64.0.2/32
